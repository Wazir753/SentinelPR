# SentinelPR environment variables (copy to .env and fill in)

# App
APP_ENV=development
LOG_LEVEL=INFO

# GitHub App credentials (wired in later steps)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Hugging Face (wired in later steps)
HF_API_TOKEN=

# Notification webhook (WhatsApp/Baileys bridge, etc.)
NOTIFICATION_WEBHOOK_URL=
