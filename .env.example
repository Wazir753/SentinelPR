# SentinelPR environment variables
# Copy to .env and fill in values before running in production.

# --- Application ---
APP_ENV=development
# development | production — mock webhook endpoint only works in development
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR

# --- GitHub App (Phase 3) ---
GITHUB_APP_ID=
# Numeric GitHub App ID from your app settings page
GITHUB_APP_PRIVATE_KEY_PATH=
# Filesystem path to the GitHub App PEM private key (never commit the key itself)
GITHUB_WEBHOOK_SECRET=
# Secret used to verify X-Hub-Signature-256 on incoming webhooks

# --- Hugging Face Inference API (Phase 2) ---
HF_API_TOKEN=
# Token for Qwen2.5-Coder-7B-Instruct patch generation

# --- Notifications (Phase 3+) ---
NOTIFY_WEBHOOK_URL=
# Generic outbound POST target (e.g. your WhatsApp/Baileys bridge)

# --- Retrieval / vector store (Phase 1) ---
CHROMA_PERSIST_DIR=
# Leave empty to use default: ./data/chroma
REPO_CLONE_DIR=
# Leave empty to use default: ./data/repos
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Hugging Face model id for code+docstring embeddings
